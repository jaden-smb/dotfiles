# Backup directory created by install.sh
.backup/

# Zsh generated files
config/zsh/.zcompdump*
config/zsh/.zsh_history

# Sensitive / machine-specific files
config/gh/hosts.yml

# Hypr fonts (large binary assets)
config/hypr/Fonts/

# Palette templates are tracked; generated palettes belong in ~/.cache/wal.

# Editor / OS noise
.DS_Store
*~
*.swp
__pycache__/

# Local experiments and generated state; never install or publish these.
config/hypr/hyprland.conf
config/waybar/*.before-*
config/waybar/scripts/*.before-*
config/**/cache/
config/**/state/
config/**/history
config/**/History
config/**/Cookies
config/**/Local Storage/
config/**/Session Storage/
config/**/IndexedDB/
config/**/storage/
config/**/accounts/
config/**/credentials*
config/**/tokens*
config/**/id_*
config/**/known_hosts
system/sddm/*.jpg
system/sddm/*.jpeg
system/sddm/*.png
system/sddm/*.webp
system/sddm/*.mp4
