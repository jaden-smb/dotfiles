* {{
    background: {background};
    foreground: {foreground};
    normal-background: @background;
    normal-foreground: @foreground;
    active-background: {color2};
    active-foreground: @foreground;
    urgent-background: {color1};
    urgent-foreground: @foreground;
    selected-normal-background: {color2};
    selected-normal-foreground: @foreground;
    selected-active-background: {color2};
    selected-active-foreground: @foreground;
    selected-urgent-background: {color1};
    selected-urgent-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    border-color: {color8};
}}
window {{ background-color: @background; }}
entry, prompt, textbox-prompt-colon {{ text-color: @foreground; }}
element.normal.normal {{ background-color: @background; text-color: @foreground; }}
element.selected.normal {{ background-color: @selected-normal-background; text-color: @foreground; }}
