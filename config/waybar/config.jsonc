[
  {
    "name": "laptop",
    "output": "eDP-1",
    "include": "~/.config/waybar/common.jsonc",
    "height": 41,
    "spacing": 0,
    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "custom/notification",
      "hyprland/window"
    ],
    "modules-right": [
      "pulseaudio",
      "hyprland/language",
      "tray",
      "network",
      "bluetooth",
      "clock",
      "battery",
      "custom/power"
    ],
    "hyprland/workspaces": {
      "on-click": "activate",
      "format": "{id}",
      "all-outputs": false,
      "disable-scroll": false,
      "active-only": false
    },
    "hyprland/window": {
      "format": "{}",
      "max-length": 14
    },
    "tray": {
      "show-passive-items": false,
      "spacing": 6
    }
  },
  {
    "name": "hdmi",
    "output": "HDMI-A-1",
    "include": "~/.config/waybar/common.jsonc",
    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "custom/notification",
      "hyprland/window"
    ],
    "modules-right": [
      "pulseaudio",
      "memory",
      "cpu",
      "hyprland/language",
      "tray",
      "network",
      "bluetooth",
      "clock",
      "power-profiles-daemon",
      "battery",
      "custom/power"
    ]
  }
]
